# CMake package config for imbh-c (prebuilt binary port).
#
# Generated by ports/imbh-c/portfile.cmake via configure_file; @VARS@ are substituted at install
# time. Exposes the imported target `imbh-c::imbh-c` (include dir + library), matching the target
# name the conan recipe advertises, so consumers write the same `find_package(imbh-c CONFIG)` /
# `target_link_libraries(app PRIVATE imbh-c::imbh-c)` regardless of which package manager delivered it.

if(TARGET imbh-c::imbh-c)
    return()
endif()

# share/imbh-c/ -> package prefix (two levels up).
get_filename_component(_imbh_c_prefix "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)

add_library(imbh-c::imbh-c @IMBH_C_LIBTYPE@ IMPORTED)
set_target_properties(imbh-c::imbh-c PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES "${_imbh_c_prefix}/include")

# --- Release (always present) ---------------------------------------------------------------------
set_property(TARGET imbh-c::imbh-c APPEND PROPERTY IMPORTED_CONFIGURATIONS RELEASE)
set_target_properties(imbh-c::imbh-c PROPERTIES
    IMPORTED_LOCATION_RELEASE "${_imbh_c_prefix}/@IMBH_C_LIB_SUBPATH@")
if(NOT "@IMBH_C_IMPLIB_SUBPATH@" STREQUAL "")
    set_target_properties(imbh-c::imbh-c PROPERTIES
        IMPORTED_IMPLIB_RELEASE "${_imbh_c_prefix}/@IMBH_C_IMPLIB_SUBPATH@")
endif()

# --- Debug (mirrors release; the prebuilt archive ships one build) --------------------------------
if(EXISTS "${_imbh_c_prefix}/debug/@IMBH_C_LIB_SUBPATH@")
    set_property(TARGET imbh-c::imbh-c APPEND PROPERTY IMPORTED_CONFIGURATIONS DEBUG)
    set_target_properties(imbh-c::imbh-c PROPERTIES
        IMPORTED_LOCATION_DEBUG "${_imbh_c_prefix}/debug/@IMBH_C_LIB_SUBPATH@")
    if(NOT "@IMBH_C_IMPLIB_SUBPATH@" STREQUAL "")
        set_target_properties(imbh-c::imbh-c PROPERTIES
            IMPORTED_IMPLIB_DEBUG "${_imbh_c_prefix}/debug/@IMBH_C_IMPLIB_SUBPATH@")
    endif()
endif()

# Map the multi-config generators' extra configurations onto Release.
set_target_properties(imbh-c::imbh-c PROPERTIES
    MAP_IMPORTED_CONFIG_MINSIZEREL Release
    MAP_IMPORTED_CONFIG_RELWITHDEBINFO Release)

# --- System libraries (only needed for static linkage; the shared lib is self-contained) ----------
set(_imbh_c_system_libs "@IMBH_C_SYSTEM_LIBS@")
if(_imbh_c_system_libs)
    set_property(TARGET imbh-c::imbh-c APPEND PROPERTY
        INTERFACE_LINK_LIBRARIES "${_imbh_c_system_libs}")
endif()
set(_imbh_c_frameworks "@IMBH_C_FRAMEWORKS@")
if(_imbh_c_frameworks AND APPLE)
    foreach(_fw IN LISTS _imbh_c_frameworks)
        set_property(TARGET imbh-c::imbh-c APPEND PROPERTY
            INTERFACE_LINK_LIBRARIES "-framework ${_fw}")
    endforeach()
endif()

unset(_imbh_c_system_libs)
unset(_imbh_c_frameworks)
unset(_imbh_c_prefix)
